<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#FF3A7FD5</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC7E200" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#33FFFFFF" />
</ResourceDictionary>
