<Window x:Class="ScreenshotProMax.Views.WindowSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Window"
        WindowStyle="None"
        WindowState="Normal"
        AllowsTransparency="True"
        Background="#40000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        Focusable="True"
        ResizeMode="NoResize">
    <Canvas x:Name="HighlightCanvas" ClipToBounds="False" />
</Window>
