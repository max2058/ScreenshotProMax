<mah:MetroWindow x:Class="ScreenshotProMax.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:mycontrols="clr-namespace:ScreenshotProMax.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:viewModels="clr-namespace:ScreenshotProMax.ViewModels"
        xmlns:models="clr-namespace:ScreenshotProMax.Models"
        xmlns:app="clr-namespace:ScreenshotProMax"
        xmlns:converters="clr-namespace:ScreenshotProMax.Converters"
        mc:Ignorable="d"
        Title="Screenshot Pro Max" 
        Height="800" Width="1200"
        TitleCharacterCasing="Normal"
        WindowStartupLocation="CenterScreen"
        SaveWindowPosition="True"
        BorderThickness="1">
  <mah:MetroWindow.Resources>
    <converters:PointsToPointCollectionConverter x:Key="PointsToPointCollectionConverter" />
    <converters:OpacityToPercentageConverter x:Key="OpacityToPercentageConverter" />
    <converters:StringToShapeStyleConverter x:Key="StringToShapeStyleConverter" />
    <converters:ResizeHandlesToVisibilityConverter x:Key="ResizeHandlesToVisibilityConverter" />

    <Style TargetType="Button" x:Key="ToolbarButton" BasedOn="{StaticResource MahApps.Styles.Button}">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="4,4" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
              <Rectangle x:Name="AccentBar"
                         Height="3"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource MahApps.Brushes.Accent}"
                         RadiusX="2" RadiusY="2"
                         Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#33000000" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#22000000" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#44000000" />
                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="RadioButton" x:Key="ToolRadioButton" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Local.VerticalSeparator" TargetType="Separator">
      <Setter Property="LayoutTransform">
        <Setter.Value>
          <RotateTransform Angle="90"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Width" Value="1"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray6}"/>
    </Style>

    <!-- Style für Resize-Handles -->
    <Style x:Key="ResizeHandleStyle" TargetType="Rectangle">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="DodgerBlue" />
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Cursor" Value="SizeAll" />
      <Style.Triggers>
        <!-- Verschiedene Cursor für verschiedene Handle-Typen -->
        <DataTrigger Binding="{Binding Type}" Value="TopLeft">
          <Setter Property="Cursor" Value="SizeNWSE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="TopRight">
          <Setter Property="Cursor" Value="SizeNESW" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="BottomLeft">
          <Setter Property="Cursor" Value="SizeNESW" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="BottomRight">
          <Setter Property="Cursor" Value="SizeNWSE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="MiddleLeft">
          <Setter Property="Cursor" Value="SizeWE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="MiddleRight">
          <Setter Property="Cursor" Value="SizeWE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="MiddleTop">
          <Setter Property="Cursor" Value="SizeNS" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="MiddleBottom">
          <Setter Property="Cursor" Value="SizeNS" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="StartPoint">
          <Setter Property="Cursor" Value="SizeAll" />
          <Setter Property="Fill" Value="Orange" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="EndPoint">
          <Setter Property="Cursor" Value="SizeAll" />
          <Setter Property="Fill" Value="Red" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </mah:MetroWindow.Resources>

  <mah:MetroWindow.DataContext>
    <viewModels:MainViewModel />
  </mah:MetroWindow.DataContext>


  <!-- Flyouts im MetroWindow eigenes Control -->
  <mah:MetroWindow.Flyouts>
    <mah:FlyoutsControl>
      <!-- Flyouts-Steuerelement -->
      <mah:Flyout Header="{Binding SettFlyHeader, Source={x:Static app:App.Loc}, Mode=OneWay}" IsOpen="{Binding IsSettingsFlyoutOpen}"
                Width="500" Position="Right" Theme="Adapt" BorderBrush="Gray" BorderThickness="1"
                CloseCommand="{Binding CloseSettingsFlyOutCommand}">
        <mycontrols:SettingsFlyout/>
      </mah:Flyout>
    </mah:FlyoutsControl>
  </mah:MetroWindow.Flyouts>


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="50"/>
      <RowDefinition Height="50"/>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1171*" />
        <ColumnDefinition Width="63*"/>
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,5,0"
                    Grid.Column="0" Grid.ColumnSpan="3">
        <!-- Capture Buttons -->
        <StackPanel Orientation="Horizontal">

          <Button Style="{StaticResource ToolbarButton}"
                  Command="{Binding CaptureRegionCommand}" 
                  ToolTip="Screenshot-Bereich auswählen (Strg+D)">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="CropFree"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" 
                            Command="{Binding CaptureActiveWindowCommand}" 
                            ToolTip="Fenster durch Anklicken auswählen">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="WindowMaximize"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" 
                            Command="{Binding CaptureCommand}" 
                            ToolTip="Bildschirm auswählen und aufnehmen">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="Monitor"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <Separator Style="{StaticResource Local.VerticalSeparator}" Height="10" Width="30"/>

        <!-- File Operations -->
        <Button Style="{StaticResource ToolbarButton}" 
                        Command="{Binding SaveCommand}" 
                        IsEnabled="{Binding HasImage}"
                        ToolTip="Screenshot speichern">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="ContentSave"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" 
                        Command="{Binding CopyToClipboardCommand}" 
                        IsEnabled="{Binding HasImage}"
                        ToolTip="In Zwischenablage kopieren (Strg+C)">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="ContentCopy"/>
          </StackPanel>
        </Button>

        <Separator Style="{StaticResource Local.VerticalSeparator}" Height="10" Width="30"/>

        <!-- Undo/Redo -->
        <Button Style="{StaticResource ToolbarButton}" 
                        Background="Transparent"
                        Command="{Binding UndoCommand}" 
                        ToolTip="Rückgängig (bis zu 10 Schritte)">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Undo"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" 
                Background="Transparent"
                        Command="{Binding RedoCommand}" 
                        ToolTip="Wiederherstellen">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Redo"/>
          </StackPanel>
        </Button>

        <Separator Style="{StaticResource Local.VerticalSeparator}" Height="10" Width="30"/>

        <Button Style="{StaticResource ToolbarButton}"
                                Background="Transparent"
                        Command="{Binding ClearAnnotationsCommand}" 
                        IsEnabled="{Binding HasImage}"
                        ToolTip="Alle Anmerkungen löschen">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="DeleteSweep"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <Button x:Name="MoreButton" Style="{StaticResource ToolbarButton}"
                  Background="Transparent"
                  Click="MoreButton_Click"
                  ToolTip="Mehr">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <iconPacks:PackIconMaterial Padding="0" Width="20" Height="20" Kind="DotsHorizontal" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Einstellungen" Command="{Binding OpenSetFlyOutCommand}">
                <MenuItem.Icon>
                  <iconPacks:PackIconMaterial Kind="CogOutline" Width="16" Height="16"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem IsEnabled="False" Header="Über Screenshot Pro Max" Command="{Binding OpenAboutCommand}">
                <MenuItem.Icon>
                  <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16"/>
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>

        </Button>

      </StackPanel>

    </Grid>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5"
                Grid.Row="1">
      <!-- Tools -->
      <StackPanel Orientation="Horizontal" Margin="8,0">
        <!-- Arrow Tool -->
        <Button Tag="Arrow" Click="ToolButton_Click" Width="36" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Pfeil (A)">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle x:Name="SelectedBar" Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource MahApps.Brushes.Accent}" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding CurrentTool}" Value="Arrow">
                  <Setter TargetName="Chrome" Property="Background" Value="#FFE4E9F2" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB5C3D1" />
                  <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <iconPacks:PackIconMaterial Kind="ArrowTopRight" />
        </Button>

        <!-- Line Tool -->
        <Button Tag="Line" Click="ToolButton_Click" Width="36" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Linie (L)">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle x:Name="SelectedBar" Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource MahApps.Brushes.Accent}" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding CurrentTool}" Value="Line">
                  <Setter TargetName="Chrome" Property="Background" Value="#FFE4E9F2" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB5C3D1" />
                  <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <iconPacks:PackIconMaterial Kind="VectorPolylineEdit" />
        </Button>

        <!-- Text Tool mit DropDown für Einstellungen -->
        <mah:DropDownButton Width="50" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" 
                            ToolTip="Text (T)" ArrowVisibility="Visible" Click="ToolButton_Click">
          <mah:DropDownButton.Tag>
            <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Text</system:String>
          </mah:DropDownButton.Tag>
          <mah:DropDownButton.Style>
            <Style TargetType="mah:DropDownButton" BasedOn="{StaticResource {x:Type mah:DropDownButton}}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentTool}" Value="Text">
                  <Setter Property="Background" Value="#FFE4E9F2" />
                  <Setter Property="BorderBrush" Value="#FFB5C3D1" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#11000000" />
                  <Setter Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </mah:DropDownButton.Style>
          <mah:DropDownButton.Content>
            <iconPacks:PackIconMaterial Kind="FormatTextbox" />
          </mah:DropDownButton.Content>
          <mah:DropDownButton.Items>
            <StackPanel Orientation="Vertical" Margin="10" MinWidth="250">
              <TextBlock Text="Text-Einstellungen" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>
              
              <!-- Font Size -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <iconPacks:PackIconMaterial Kind="FormatSize" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Schriftgröße:" VerticalAlignment="Center" MinWidth="80"/>
                <Slider Minimum="8" Maximum="72" Value="{Binding CurrentFontSize, Mode=TwoWay}"
                        Width="120" Style="{StaticResource MahApps.Styles.Slider}" Margin="8,0"/>
                <TextBlock Text="{Binding CurrentFontSize, StringFormat='{}{0:0}pt'}" VerticalAlignment="Center" MinWidth="35"/>
              </StackPanel>
              
              <!-- Text Scale -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <iconPacks:PackIconMaterial Kind="MagnifyPlusOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Skalierung:" VerticalAlignment="Center" MinWidth="80"/>
                <Slider Minimum="0.5" Maximum="3.0" Value="{Binding CurrentTextScale, Mode=TwoWay}"
                        Width="120" Style="{StaticResource MahApps.Styles.Slider}" Margin="8,0"/>
                <TextBlock VerticalAlignment="Center" MinWidth="35">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:0}%">
                      <Binding Path="CurrentTextScale" Converter="{StaticResource OpacityToPercentageConverter}" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
              
              <Separator Margin="0,5"/>
              
              <Button Content="Text-Werkzeug aktivieren" Click="TextToolActivate_Click" 
                      Style="{StaticResource MahApps.Styles.Button}" Margin="0,5,0,0"/>
            </StackPanel>
          </mah:DropDownButton.Items>
        </mah:DropDownButton>

        <!-- Number Tool mit DropDown für Einstellungen -->
        <mah:DropDownButton Width="50" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" 
                            ToolTip="Nummer (N)" ArrowVisibility="Visible" Click="ToolButton_Click">
          <mah:DropDownButton.Tag>
            <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Number</system:String>
          </mah:DropDownButton.Tag>
          <mah:DropDownButton.Style>
            <Style TargetType="mah:DropDownButton" BasedOn="{StaticResource {x:Type mah:DropDownButton}}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentTool}" Value="Number">
                  <Setter Property="Background" Value="#FFE4E9F2" />
                  <Setter Property="BorderBrush" Value="#FFB5C3D1" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#11000000" />
                  <Setter Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </mah:DropDownButton.Style>
          <mah:DropDownButton.Content>
            <iconPacks:PackIconMaterial Kind="Numeric1CircleOutline" />
          </mah:DropDownButton.Content>
          <mah:DropDownButton.Items>
            <StackPanel Orientation="Vertical" Margin="10" MinWidth="250">
              <TextBlock Text="Nummer-Einstellungen" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>
              
              <!-- Number Scale -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <iconPacks:PackIconMaterial Kind="MagnifyPlusOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Skalierung:" VerticalAlignment="Center" MinWidth="80"/>
                <Slider Minimum="0.8" Maximum="4.0" Value="{Binding CurrentNumberScale, Mode=TwoWay}"
                        Width="120" Style="{StaticResource MahApps.Styles.Slider}" Margin="8,0"/>
                <TextBlock VerticalAlignment="Center" MinWidth="35">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:0}%">
                      <Binding Path="CurrentNumberScale" Converter="{StaticResource OpacityToPercentageConverter}" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
              
              <Separator Margin="0,5"/>
              
              <Button Content="Nummer-Werkzeug aktivieren" Click="NumberToolActivate_Click" 
                      Style="{StaticResource MahApps.Styles.Button}" Margin="0,5,0,0"/>
            </StackPanel>
          </mah:DropDownButton.Items>
        </mah:DropDownButton>

        <!-- Rectangle Tool -->
        <Button Tag="Rectangle" Click="ToolButton_Click" Width="36" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Rechteck (R)">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle x:Name="SelectedBar" Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource MahApps.Brushes.Accent}" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding CurrentTool}" Value="Rectangle">
                  <Setter TargetName="Chrome" Property="Background" Value="#FFE4E9F2" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB5C3D1" />
                  <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <iconPacks:PackIconMaterial Kind="RectangleOutline" />
        </Button>

        <!-- Ellipse Tool -->
        <Button Tag="Ellipse" Click="ToolButton_Click" Width="36" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Kreis/Ellipse (E)">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle x:Name="SelectedBar" Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource MahApps.Brushes.Accent}" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding CurrentTool}" Value="Ellipse">
                  <Setter TargetName="Chrome" Property="Background" Value="#FFE4E9F2" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB5C3D1" />
                  <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <iconPacks:PackIconMaterial Kind="EllipseOutline" />
        </Button>

        <Separator Style="{StaticResource Local.VerticalSeparator}" Height="10" Width="30"/>

        <!-- Selection Tool (noch nicht implementiert) -->
        <Button Tag="Selection" Click="ToolButton_Click" Width="36" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Auswahl (S)">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle x:Name="SelectedBar" Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource MahApps.Brushes.Accent}" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding CurrentTool}" Value="Selection">
                  <Setter TargetName="Chrome" Property="Background" Value="#FFE4E9F2" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB5C3D1" />
                  <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <iconPacks:PackIconMaterial Kind="CursorDefaultOutline" />
        </Button>

        <!-- Eraser Tool (noch nicht implementiert) -->
        <Button Tag="Eraser" Click="ToolButton_Click" Width="36" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Radierer">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle x:Name="SelectedBar" Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource MahApps.Brushes.Accent}" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#11000000" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#33000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <iconPacks:PackIconMaterial Kind="Eraser" />
        </Button>
      </StackPanel>

      <Separator Style="{StaticResource Local.VerticalSeparator}" Height="10" Width="30"/>

      <!-- Color -->
      <StackPanel Orientation="Horizontal" Margin="0,0,5,0">
        <mah:ColorPicker SelectedColor="{Binding CurrentColor, Mode=TwoWay}" />
      </StackPanel>

      <!-- Shape Style (nur sichtbar bei Rechteck/Kreis) -->
      <StackPanel Orientation="Horizontal" Margin="0,0,5,0">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentTool}" Value="Rectangle">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding CurrentTool}" Value="Ellipse">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="Stil:" 
                     VerticalAlignment="Center" 
                     Margin="0,0,6,0"
                     FontSize="13"/>
        <ComboBox Width="140" 
                    SelectedIndex="0"
                    SelectedValue="{Binding CurrentShapeStyle, Mode=TwoWay, Converter={StaticResource StringToShapeStyleConverter}}"
                    SelectedValuePath="Tag">
          <ComboBoxItem Content="Nur Rahmen" Tag="StrokeOnly" />
          <ComboBoxItem Content="Rahmen + Füllung" Tag="StrokeAndFill" />
          <ComboBoxItem Content="Nur Füllung" Tag="FillOnly" />
        </ComboBox>
      </StackPanel>

      <!-- Thickness -->
      <StackPanel Orientation="Horizontal">
        <iconPacks:PackIconMaterial Kind="PencilPlusOutline" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      Margin="5,0,5,0"/>
        <Slider Minimum="1" Maximum="12" Value="{Binding CurrentThickness, Mode=TwoWay}"
                  Width="90" Style="{StaticResource MahApps.Styles.Slider}"/>
        <TextBlock Text="{Binding CurrentThickness, StringFormat='{}{0:0}'}"
             VerticalAlignment="Center"
             Margin="6,0,0,0"
             FontSize="13"
             MinWidth="20"/>
      </StackPanel>

      <!-- Opacity -->
      <StackPanel Orientation="Horizontal">
        <iconPacks:PackIconMaterial Kind="CircleOpacity" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center" 
                             Margin="5,0,5,0"/>
        <Slider Minimum="0.2" Maximum="1" Value="{Binding CurrentOpacity, Mode=TwoWay}"
         Width="100" Style="{StaticResource MahApps.Styles.Slider}"/>
        <TextBlock VerticalAlignment="Center"
             Margin="6,0,0,0"
             FontSize="13"
             MinWidth="35">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0:0}%">
              <Binding Path="CurrentOpacity" Converter="{StaticResource OpacityToPercentageConverter}" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>

      <!-- Zoom -->
      <StackPanel Orientation="Horizontal">
        <iconPacks:PackIconMaterial Kind="MagnifyPlusOutline"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}"
             VerticalAlignment="Center"
             Margin="0,0,8,0"
             FontSize="13"
             MinWidth="45"/>
      </StackPanel>
    </StackPanel>

    <!-- Canvas Area -->
    <ScrollViewer Grid.Row="2" 
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource MahApps.Brushes.Accent4}">
      <Grid>
       

        <TextBlock HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                Padding="8">
          <!-- Inline image + text inside TextBlock using InlineUIContainer + Run -->
          <InlineUIContainer BaselineAlignment="Center">
            <iconPacks:PackIconMaterial Kind="Camera" Height="18" Width="18" />
          </InlineUIContainer>
            <Run Text="{Binding MasterInfoText, Source={x:Static app:App.Loc}, Mode=OneWay}"/>
        </TextBlock>


        <!-- Neuer Border nur um das eigentliche Screenshot-Bild + Overlay -->
        <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                        BorderThickness="2"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasImage, Converter={x:Static converters:BooleanToVisibilityConverter.Instance}}"
                        RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
          </Border.RenderTransform>
          <Grid>
            <Image x:Name="ScreenshotImage"
                               Source="{Binding CapturedImage}"
                               Stretch="None"/>
            <Canvas x:Name="OverlayCanvas"
                                Background="Transparent"
                                Width="{Binding ElementName=ScreenshotImage, Path=ActualWidth}"
                                Height="{Binding ElementName=ScreenshotImage, Path=ActualHeight}"
                                MouseDown="OverlayCanvas_MouseDown"
                                MouseMove="OverlayCanvas_MouseMove"
                                MouseUp="OverlayCanvas_MouseUp"
                                MouseWheel="OverlayCanvas_MouseWheel">
              <ItemsControl ItemsSource="{Binding Annotations}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:AnnotationModel}">
                    <Canvas>
                      <!-- Kontextmenü für ausgewählte Annotation -->
                      <Canvas.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Löschen" Click="DeleteAnnotationMenuItem_Click" InputGestureText="Entf">
                            <MenuItem.Icon>
                              <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Kopieren" Click="CopyAnnotationMenuItem_Click" InputGestureText="Strg+C">
                            <MenuItem.Icon>
                              <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="In den Vordergrund" Click="BringToFrontMenuItem_Click">
                            <MenuItem.Icon>
                              <iconPacks:PackIconMaterial Kind="ArrowTopLeft" Width="16" Height="16"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="In den Hintergrund" Click="SendToBackMenuItem_Click">
                            <MenuItem.Icon>
                              <iconPacks:PackIconMaterial Kind="ArrowBottomRight" Width="16" Height="16"/>
                            </MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Canvas.ContextMenu>

                      <!-- Line/Arrow mit Auswahl-Highlight -->
                      <Line Stroke="{Binding StrokeBrush}" 
                            StrokeThickness="{Binding Thickness}" 
                            X1="{Binding Points[0].X}" 
                            Y1="{Binding Points[0].Y}" 
                            X2="{Binding Points[1].X}" 
                            Y2="{Binding Points[1].Y}">
                        <Line.Style>
                          <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Line">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="StrokeStartLineCap" Value="Round" />
                                <Setter Property="StrokeEndLineCap" Value="Round" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="Arrow">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="StrokeStartLineCap" Value="Round" />
                                <Setter Property="StrokeEndLineCap" Value="Round" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Line.Style>
                      </Line>

                      <!-- Pfeilspitze als gefülltes Dreieck -->
                      <Polygon Fill="{Binding StrokeBrush}" 
                               Stroke="{Binding StrokeBrush}"
                               StrokeThickness="1"
                               Points="{Binding ArrowHeadPoints}">
                        <Polygon.Style>
                          <Style TargetType="Polygon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Arrow">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Polygon.Style>
                      </Polygon>

                      <!-- Auswahl-Highlight für Linien/Pfeile -->
                      <Line Stroke="DodgerBlue" 
                            StrokeThickness="8" 
                            Opacity="0.3"
                            X1="{Binding Points[0].X}" 
                            Y1="{Binding Points[0].Y}" 
                            X2="{Binding Points[1].X}" 
                            Y2="{Binding Points[1].Y}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round">
                        <Line.Style>
                          <Style TargetType="Line">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                              </MultiDataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="Number">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="Text">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Type}" Value="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Line.Style>
                      </Line>

                      <!-- Rectangle Shape -->
                      <Rectangle Canvas.Left="{Binding ShapeBounds.X}"
                                 Canvas.Top="{Binding ShapeBounds.Y}"
                                 Width="{Binding ShapeBounds.Width}"
                                 Height="{Binding ShapeBounds.Height}">
                        <Rectangle.Style>
                          <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Rectangle">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <!-- Nur Rahmen -->
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Rectangle"/>
                                  <Condition Binding="{Binding ShapeStyle}" Value="StrokeOnly"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
                                <Setter Property="StrokeThickness" Value="{Binding Thickness}" />
                                <Setter Property="Fill" Value="Transparent" />
                              </MultiDataTrigger>
                              <!-- Rahmen + Füllung -->
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Rectangle"/>
                                  <Condition Binding="{Binding ShapeStyle}" Value="StrokeAndFill"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
                                <Setter Property="StrokeThickness" Value="{Binding Thickness}" />
                                <Setter Property="Fill" Value="{Binding FillBrush}" />
                              </MultiDataTrigger>
                              <!-- Nur Füllung -->
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Rectangle"/>
                                  <Condition Binding="{Binding ShapeStyle}" Value="FillOnly"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="0" />
                                <Setter Property="Fill" Value="{Binding FillBrush}" />
                              </MultiDataTrigger>
                              <!-- Highlight wenn ausgewählt -->
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="StrokeDashArray" Value="4,2" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Rectangle.Style>
                      </Rectangle>

                      <!-- Ellipse Shape -->
                      <Ellipse Canvas.Left="{Binding ShapeBounds.X}"
                               Canvas.Top="{Binding ShapeBounds.Y}"
                               Width="{Binding ShapeBounds.Width}"
                               Height="{Binding ShapeBounds.Height}">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <!-- Nur Rahmen -->
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Ellipse"/>
                                  <Condition Binding="{Binding ShapeStyle}" Value="StrokeOnly"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
                                <Setter Property="StrokeThickness" Value="{Binding Thickness}" />
                                <Setter Property="Fill" Value="Transparent" />
                              </MultiDataTrigger>
                              <!-- Rahmen + Füllung -->
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Ellipse"/>
                                  <Condition Binding="{Binding ShapeStyle}" Value="StrokeAndFill"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
                                <Setter Property="StrokeThickness" Value="{Binding Thickness}" />
                                <Setter Property="Fill" Value="{Binding FillBrush}" />
                              </MultiDataTrigger>
                              <!-- Nur Füllung -->
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Ellipse"/>
                                  <Condition Binding="{Binding ShapeStyle}" Value="FillOnly"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="0" />
                                <Setter Property="Fill" Value="{Binding FillBrush}" />
                              </MultiDataTrigger>
                              <!-- Highlight wenn ausgewählt -->
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="StrokeDashArray" Value="4,2" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>

                      <!-- Number Badge -->
                      <Border Background="{Binding FillBrush}" 
                              BorderBrush="White" 
                              BorderThickness="2" 
                              CornerRadius="16"
                              Padding="8,4"
                              Canvas.Left="{Binding Points[0].X}"
                              Canvas.Top="{Binding Points[0].Y}">
                        <Border.RenderTransform>
                          <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                        </Border.RenderTransform>
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Number">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Number"/>
                                  <Condition Binding="{Binding IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="DodgerBlue"/>
                                <Setter Property="BorderThickness" Value="3"/>
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Text}" 
                                   Foreground="White" 
                                   FontWeight="Bold"
                                   FontSize="14"/>
                      </Border>

                      <!-- Text Label - Editable -->
                      <Border Background="{Binding FillBrush}" 
                              BorderBrush="White" 
                              BorderThickness="2" 
                              CornerRadius="4"
                              Padding="8,4"
                              MinWidth="80"
                              Canvas.Left="{Binding Points[0].X}"
                              Canvas.Top="{Binding Points[0].Y}">
                        <Border.RenderTransform>
                          <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                        </Border.RenderTransform>
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Type}" Value="Text">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding Type}" Value="Text"/>
                                  <Condition Binding="{Binding IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="DodgerBlue"/>
                                <Setter Property="BorderThickness" Value="3"/>
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                 Foreground="White" 
                                 FontSize="{Binding FontSize}"
                                 FontWeight="SemiBold"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="White"
                                 SelectionBrush="#80FFFFFF"
                                 MinWidth="60"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap">
                          <TextBox.Style>
                            <Style TargetType="TextBox">
                              <!-- TextBox ist standardmäßig schreibgeschützt -->
                              <Setter Property="IsReadOnly" Value="True"/>
                              <Setter Property="Cursor" Value="Arrow"/>
                              <Setter Property="Focusable" Value="False"/>
                              <Style.Triggers>
                                <!-- Nur wenn ausgewählt, wird die TextBox bearbeitbar -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="IsReadOnly" Value="False"/>
                                  <Setter Property="Cursor" Value="IBeam"/>
                                  <Setter Property="Focusable" Value="True"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                      </Border>

                      <!-- Resize Handles für ausgewählte Anmerkungen -->
                      <ItemsControl ItemsSource="{Binding ResizeHandles}"
                                    Visibility="{Binding ResizeHandles, Converter={StaticResource ResizeHandlesToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={x:Static converters:SubtractConverter.Instance}, ConverterParameter=4}" />
                            <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={x:Static converters:SubtractConverter.Instance}, ConverterParameter=4}" />
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Rectangle Style="{StaticResource ResizeHandleStyle}" 
                                       Tag="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</mah:MetroWindow>
