<mah:MetroWindow x:Class="ScreenshotProMax.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:viewModels="clr-namespace:ScreenshotProMax.ViewModels"
        xmlns:models="clr-namespace:ScreenshotProMax.Models"
        xmlns:converters="clr-namespace:ScreenshotProMax.Converters"
        mc:Ignorable="d"
        Title="ScreenshotProMax" 
        Height="720" Width="1280"
        TitleCharacterCasing="Normal"
        WindowStartupLocation="CenterScreen"
        SaveWindowPosition="True"
        BorderThickness="1">
    <mah:MetroWindow.Resources>
        <converters:PointsToPointCollectionConverter x:Key="PointsToPointCollectionConverter" />
        
        <Style TargetType="Button" x:Key="ToolbarButton" BasedOn="{StaticResource MahApps.Styles.Button}">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        
        <Style TargetType="RadioButton" x:Key="ToolRadioButton" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="FontSize" Value="13" />
        </Style>
        
        <Style x:Key="Local.VerticalSeparator" TargetType="Separator">
          <Setter Property="LayoutTransform">
            <Setter.Value>
              <RotateTransform Angle="90"/>
            </Setter.Value>
          </Setter>
          <Setter Property="Width" Value="1"/>
          <Setter Property="Margin" Value="8,0"/>
          <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray6}"/>
        </Style>
    </mah:MetroWindow.Resources>
    
    <mah:MetroWindow.DataContext>
        <viewModels:MainViewModel />
    </mah:MetroWindow.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource MahApps.Brushes.Accent4}" 
                Padding="12,8" 
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}" 
                BorderThickness="0,0,0,2">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Capture Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="📸 Aufnahme:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0" 
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <Button Style="{StaticResource ToolbarButton}" 
                            Command="{Binding CaptureRegionCommand}" 
                            ToolTip="Screenshot-Bereich auswählen (Strg+D)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CropFree" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Region"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" 
                            Command="{Binding CaptureActiveWindowCommand}" 
                            ToolTip="Aktives Fenster aufnehmen">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="WindowMaximize" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Fenster"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" 
                            Command="{Binding CaptureCommand}" 
                            ToolTip="Primären Bildschirm aufnehmen">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Monitor" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Bildschirm"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" 
                            Command="{Binding CaptureAllScreensCommand}" 
                            ToolTip="Alle Bildschirme aufnehmen">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="MonitorMultiple" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Alle"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <Separator Style="{StaticResource Local.VerticalSeparator}" Height="30" />
                
                <!-- File Operations -->
                <Button Style="{StaticResource ToolbarButton}" 
                        Command="{Binding SaveCommand}" 
                        IsEnabled="{Binding HasImage}"
                        ToolTip="Screenshot speichern">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Speichern"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" 
                        Command="{Binding ClearAnnotationsCommand}" 
                        IsEnabled="{Binding HasImage}"
                        ToolTip="Alle Anmerkungen löschen">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="DeleteSweep" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Löschen"/>
                    </StackPanel>
                </Button>
                
                <Separator Style="{StaticResource Local.VerticalSeparator}" Height="30" />
                
                <!-- Tools -->
                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <TextBlock Text="🎨 Werkzeug:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <RadioButton Content="Pfeil" 
                                GroupName="Tools" 
                                Tag="Arrow" 
                                IsChecked="True" 
                                Checked="ToolRadio_Checked" 
                                Style="{StaticResource ToolRadioButton}"/>
                    <RadioButton Content="Linie" 
                                GroupName="Tools" 
                                Tag="Line" 
                                Checked="ToolRadio_Checked" 
                                Style="{StaticResource ToolRadioButton}"/>
                    <RadioButton Content="Text" 
                                GroupName="Tools" 
                                Tag="Text" 
                                Checked="ToolRadio_Checked" 
                                Style="{StaticResource ToolRadioButton}"/>
                    <RadioButton Content="Nummer" 
                                GroupName="Tools" 
                                Tag="Number" 
                                Checked="ToolRadio_Checked" 
                                Style="{StaticResource ToolRadioButton}"/>
                    <RadioButton Content="Freihand" 
                                GroupName="Tools" 
                                Tag="Pen" 
                                Checked="ToolRadio_Checked" 
                                Style="{StaticResource ToolRadioButton}"/>
                </StackPanel>
                
                <Separator Style="{StaticResource Local.VerticalSeparator}" Height="30" />
                
                <!-- Color -->
                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <TextBlock Text="Farbe:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,6,0"
                               FontSize="13"/>
                    <ComboBox Width="110" 
                             SelectionChanged="ColorCombo_SelectionChanged" 
                             SelectedIndex="0"
                             Style="{StaticResource MahApps.Styles.ComboBox}">
                        <ComboBoxItem Content="Rot" Tag="#FFe74c3c" />
                        <ComboBoxItem Content="Gelb" Tag="#FFf1c40f" />
                        <ComboBoxItem Content="Grün" Tag="#FF2ecc71" />
                        <ComboBoxItem Content="Cyan" Tag="#FF1abc9c" />
                        <ComboBoxItem Content="Lila" Tag="#FF8e44ad" />
                    </ComboBox>
                </StackPanel>
                
                <!-- Thickness -->
                <StackPanel Orientation="Horizontal" Margin="8,0" Width="140">
                    <TextBlock Text="Dicke:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,6,0"
                               FontSize="13"/>
                    <Slider Minimum="1" 
                           Maximum="12" 
                           Value="{Binding CurrentThickness, Mode=TwoWay}"
                           Width="90"
                           Style="{StaticResource MahApps.Styles.Slider}"/>
                </StackPanel>
                
                <!-- Opacity -->
                <StackPanel Orientation="Horizontal" Margin="8,0" Width="150">
                    <TextBlock Text="Transparenz:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,6,0"
                               FontSize="13"/>
                    <Slider Minimum="0.2" 
                           Maximum="1" 
                           Value="{Binding CurrentOpacity, Mode=TwoWay}"
                           Width="80"
                           Style="{StaticResource MahApps.Styles.Slider}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Canvas Area -->
        <ScrollViewer Grid.Row="1" 
                     Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto">
            <Grid>
                <TextBlock Text="📸 Drücken Sie Strg+D oder wählen Sie eine Aufnahmeoption"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="18"
                          Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                          Visibility="{Binding HasImage, Converter={x:Static converters:BooleanToVisibilityConverter.InvertedInstance}}"/>
                
                <Image x:Name="ScreenshotImage" 
                      Source="{Binding CapturedImage}" 
                      Stretch="None" />
                      
                <Canvas x:Name="OverlayCanvas" 
                       Background="Transparent"
                       Width="{Binding ElementName=ScreenshotImage, Path=ActualWidth}"
                       Height="{Binding ElementName=ScreenshotImage, Path=ActualHeight}"
                       MouseDown="OverlayCanvas_MouseDown"
                       MouseMove="OverlayCanvas_MouseMove"
                       MouseUp="OverlayCanvas_MouseUp"
                       Visibility="{Binding HasImage, Converter={x:Static converters:BooleanToVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Annotations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AnnotationModel}">
                                <Canvas>
                                    <!-- Line/Arrow -->
                                    <Line Stroke="{Binding StrokeBrush}" 
                                         StrokeThickness="{Binding Thickness}" 
                                         X1="{Binding Points[0].X}" 
                                         Y1="{Binding Points[0].Y}" 
                                         X2="{Binding Points[1].X}" 
                                         Y2="{Binding Points[1].Y}">
                                        <Line.Style>
                                            <Style TargetType="Line">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Line">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                                        <Setter Property="StrokeEndLineCap" Value="Round" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Arrow">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                                        <Setter Property="StrokeEndLineCap" Value="Triangle" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Line.Style>
                                    </Line>
                                    
                                    <!-- Pen (Freehand) -->
                                    <Polyline StrokeThickness="{Binding Thickness}" 
                                             Stroke="{Binding StrokeBrush}" 
                                             Points="{Binding Points, Converter={StaticResource PointsToPointCollectionConverter}}" 
                                             StrokeLineJoin="Round" 
                                             StrokeStartLineCap="Round" 
                                             StrokeEndLineCap="Round">
                                        <Polyline.Style>
                                            <Style TargetType="Polyline">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Pen">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Polyline.Style>
                                    </Polyline>
                                    
                                    <!-- Number Badge -->
                                    <Border Background="{Binding FillBrush}" 
                                           BorderBrush="White" 
                                           BorderThickness="2" 
                                           CornerRadius="16"
                                           Padding="8,4"
                                           Canvas.Left="{Binding Points[0].X}"
                                           Canvas.Top="{Binding Points[0].Y}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Number">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}" 
                                                  Foreground="White" 
                                                  FontWeight="Bold"
                                                  FontSize="14"/>
                                    </Border>
                                    
                                    <!-- Text Label - Editable -->
                                    <Border Background="{Binding FillBrush}" 
                                           BorderBrush="White" 
                                           BorderThickness="2" 
                                           CornerRadius="4"
                                           Padding="8,4"
                                           MinWidth="80"
                                           Canvas.Left="{Binding Points[0].X}"
                                           Canvas.Top="{Binding Points[0].Y}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Text">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                                Foreground="White" 
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CaretBrush="White"
                                                SelectionBrush="#80FFFFFF"
                                                MinWidth="60"/>
                                    </Border>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>