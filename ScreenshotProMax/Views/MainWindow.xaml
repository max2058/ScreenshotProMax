<Window x:Class="ScreenshotProMax.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ScreenshotProMax.ViewModels"
        xmlns:models="clr-namespace:ScreenshotProMax.Models"
        xmlns:converters="clr-namespace:ScreenshotProMax.Converters"
        mc:Ignorable="d"
        Title="ScreenshotProMax" Height="720" Width="1280"
        Background="#FF0F0F10">
    <Window.Resources>
        <converters:PointsToPointCollectionConverter x:Key="PointsToPointCollectionConverter" />
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" Padding="12" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0 0 0 1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button Style="{StaticResource ToolbarButton}" Content="Bild aufnehmen" Command="{Binding CaptureCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Speichern" Command="{Binding SaveCommand}" IsEnabled="{Binding HasImage}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Anmerkungen löschen" Command="{Binding ClearAnnotationsCommand}" IsEnabled="{Binding HasImage}" />
                <Separator Width="16" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Werkzeug:" Foreground="White" VerticalAlignment="Center" />
                    <RadioButton Content="Pfeil" GroupName="Tools" Tag="Arrow" IsChecked="True" Checked="ToolRadio_Checked" Foreground="White" />
                    <RadioButton Content="Linie" GroupName="Tools" Tag="Line" Checked="ToolRadio_Checked" Foreground="White" />
                    <RadioButton Content="Text" GroupName="Tools" Tag="Text" Checked="ToolRadio_Checked" Foreground="White" />
                    <RadioButton Content="Nummer" GroupName="Tools" Tag="Number" Checked="ToolRadio_Checked" Foreground="White" />
                    <RadioButton Content="Freihand" GroupName="Tools" Tag="Pen" Checked="ToolRadio_Checked" Foreground="White" />
                </StackPanel>
                <Separator Width="16" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Farbe" Foreground="White" VerticalAlignment="Center" />
                    <ComboBox Width="120" SelectionChanged="ColorCombo_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Rot" Tag="#FFe74c3c" />
                        <ComboBoxItem Content="Gelb" Tag="#FFf1c40f" />
                        <ComboBoxItem Content="Grün" Tag="#FF2ecc71" />
                        <ComboBoxItem Content="Cyan" Tag="#FF1abc9c" />
                        <ComboBoxItem Content="Lila" Tag="#FF8e44ad" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Dicke" Foreground="White" VerticalAlignment="Center" />
                    <Slider Width="120" Minimum="1" Maximum="12" Value="{Binding CurrentThickness, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Transparenz" Foreground="White" VerticalAlignment="Center" />
                    <Slider Width="120" Minimum="0.2" Maximum="1" Value="{Binding CurrentOpacity, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Background="#FF111115">
            <Grid>
                <Image x:Name="ScreenshotImage" Source="{Binding CapturedImage}" Stretch="None" />
                <Canvas x:Name="OverlayCanvas" Background="Transparent"
                        Width="{Binding ElementName=ScreenshotImage, Path=ActualWidth}"
                        Height="{Binding ElementName=ScreenshotImage, Path=ActualHeight}"
                        MouseDown="OverlayCanvas_MouseDown"
                        MouseMove="OverlayCanvas_MouseMove"
                        MouseUp="OverlayCanvas_MouseUp">
                    <ItemsControl ItemsSource="{Binding Annotations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AnnotationModel}">
                                <Grid>
                                    <Line Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding Thickness}" X1="{Binding Points[0].X}" Y1="{Binding Points[0].Y}" X2="{Binding Points[1].X}" Y2="{Binding Points[1].Y}">
                                        <Line.Style>
                                            <Style TargetType="Line">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Line">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                                        <Setter Property="StrokeEndLineCap" Value="Round" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Arrow">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                                        <Setter Property="StrokeEndLineCap" Value="Triangle" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Line.Style>
                                    </Line>
                                    <Polyline StrokeThickness="{Binding Thickness}" Stroke="{Binding StrokeBrush}" Points="{Binding Points, Converter={StaticResource PointsToPointCollectionConverter}}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Polyline.Style>
                                            <Style TargetType="Polyline">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <DataTrigger Binding="{Binding Type}" Value="Pen">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style>
                                        </Polyline.Style>
                                    </Polyline>
                                    <Border Background="{Binding FillBrush}" BorderBrush="White" BorderThickness="1" CornerRadius="14"
                                            Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Visibility="Collapsed"
                                            Canvas.Left="{Binding Points[0].X}" Canvas.Top="{Binding Points[0].Y}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Number">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="18" Visibility="Collapsed"
                                               Canvas.Left="{Binding Points[0].X}" Canvas.Top="{Binding Points[0].Y}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Text">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
