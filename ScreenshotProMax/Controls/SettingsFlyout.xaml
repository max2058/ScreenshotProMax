<UserControl x:Class="ScreenshotProMax.Controls.SettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:ScreenshotProMax.Controls"
             xmlns:viewModels="clr-namespace:ScreenshotProMax.ViewModels"
             xmlns:res="clr-namespace:ScreenshotProMax.Resources"
             xmlns:conv="clr-namespace:ScreenshotProMax.Converters"
             xmlns:app="clr-namespace:ScreenshotProMax"
             mc:Ignorable="d">

  <UserControl.DataContext>
    <viewModels:SettingsFlyoutViewModel/>
  </UserControl.DataContext>

  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolConverter"/>
  </UserControl.Resources>

  <StackPanel Margin="20,5,20,15">
    <Label Content="{Binding SettFlyLang, Source={x:Static app:App.Loc}}" Margin="0,0,0,5" FontWeight="Bold" FontSize="20"/>
    <mah:SplitButton HorizontalContentAlignment="Left" ItemsSource="{Binding SupportedCultures}"
                     SelectedItem="{Binding SelectedCulture}" DisplayMemberPath="NativeName">
      <mah:SplitButton.Icon>
        <iconPacks:PackIconMaterial Kind="Earth" Margin="5,0,10,0"/>
      </mah:SplitButton.Icon>
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="SelectionChanged">
          <i:InvokeCommandAction Command="{Binding LangSplBtnSelectionChangedCommand}"/>
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </mah:SplitButton>

    <Label Content="{Binding SettFlyStyle, Source={x:Static app:App.Loc}}" FontWeight="Bold" Margin="0,15,0,0" FontSize="20"/>

    <!-- Compact horizontal layout for theme toggle -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
      <!-- Sun icon left -->
      <iconPacks:PackIconMaterial Kind="WeatherSunny" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
      
      <!-- Toggle in middle: set explicit small width and remove On/Off text -->
      <mah:ToggleSwitch IsOn="{Binding IsDarkTheme, Mode=TwoWay}" ToolTip="{Binding SettFlyStyle, Source={x:Static app:App.Loc}}"
                        OnContent="" OffContent="" Width="40" Height="30" MinWidth="44" Padding="0" HorizontalAlignment="Center" Margin="0,0,2,0" />
      
      <!-- Moon icon right -->
      <iconPacks:PackIconMaterial Kind="WeatherNight" Width="20" Height="20" VerticalAlignment="Center" Margin="5,0,0,0"/>
    </StackPanel>

    <Label Content="Standard App" FontWeight="Bold" Margin="0,15,0,0" FontSize="20"/>

    <!-- Toggle for default screenshot app -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0">
      <Label Content="App als Standard für Bildschirmfotos verwenden." VerticalAlignment="Center" Margin="0,0,10,0"/>
      <mah:ToggleSwitch IsOn="{Binding IsDefaultScreenshotApp, Mode=TwoWay}" 
                        OnContent="" OffContent="" Width="40" Height="30" MinWidth="44" Padding="0" />
    </StackPanel>

    <TextBlock Margin="5,5,0,0" TextWrapping="Wrap" Foreground="Gray" FontSize="11">
      <Run Text="Wenn aktiviert, wird die Druck-Taste den Bereichsscreenshot von ScreenshotProMax auslösen. Das 'Snipping Tool' wird nicht mehr verwendet."/>
      <LineBreak/>
      <Run Text="Für diese Einstellung muss die App einmalig mit erhöten Administratorrechten gestartet werden!" FontWeight="Bold"/>
    </TextBlock>

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Label Content="{Binding AppVersionText, Source={x:Static app:App.Loc}}"/>
        <Label Content="{Binding AppVersion}"/>
      </StackPanel>

  </StackPanel>
</UserControl>
